@page
@model DLS_Web.Pages.LoginModel
@{
    ViewData["Title"] = "Log ind";
}

<h1>Log ind</h1>

<div class="col-md-4">
    @if (Model.Fejl != "")
    {
        <div class="alert alert-danger">@Model.Fejl</div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="BrugerNavn" class="form-label">Brugernavn</label>
            <input asp-for="BrugerNavn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Adgangskode" class="form-label">Adgangskode</label>
            <input asp-for="Adgangskode" type="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Log ind</button>
    </form>

    <p class="mt-3">Har du ikke en bruger? <a asp-page="/Opret">Opret dig her</a></p>

    <p class="text-muted">
        Testbrugere (kode 1234):<br />
        Leder: mette<br />
        Spejdere: ida, noah, oliver
    </p>
</div>
