@page "{id:int}"
@model DLS_Web.Pages.Aktiviteter.TilmeldteModel
@{
    ViewData["Title"] = "Tilmeldte";
}

<h1>Tilmeldte til @Model.Aktivitet.Navn</h1>
<p>@Model.Tilmeldinger.Count ud af @Model.Aktivitet.MaksDeltagere pladser er taget.</p>

@if (Model.Tilmeldinger.Count == 0)
{
    <p>Ingen spejdere er tilmeldt endnu.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Navn</th>
            <th>Alder</th>
            <th>Tegn</th>
            <th>Tilmeldt den</th>
            <th></th>
        </tr>
        @foreach (Tilmelding t in Model.Tilmeldinger)
        {
            Spejder? s = Model.HentSpejder(t.SpejderId);
            if (s != null)
            {
                <tr>
                    <td>@s.Navn</td>
                    <td>@s.Alder år</td>
                    <td>@Model.TegnNavne(s)</td>
                    <td>@t.Dato.ToString("dd-MM-yyyy")</td>
                    <td>
                        <form method="post" asp-page-handler="Fjern" asp-route-id="@Model.Aktivitet.Id" asp-route-spejderId="@s.Id">
                            <button type="submit" class="btn btn-danger btn-sm">Fjern</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </table>
}

<a asp-page="Index" class="btn btn-secondary">Tilbage</a>
