@page
@model DLS_Web.Pages.Aktiviteter.IndexModel
@{
    ViewData["Title"] = "Aktiviteter";
}

<h1>Aktiviteter</h1>

<p>
    <a asp-route-vis="alle" class="btn btn-outline-primary btn-sm">Vis alle</a>
    @if (Model.ErLeder)
    {
        <a asp-route-vis="mine" class="btn btn-outline-primary btn-sm">Vis dem jeg står for</a>
        <a asp-page="Rediger" class="btn btn-primary btn-sm">Opret ny aktivitet</a>
    }
    else
    {
        <a asp-route-vis="mine" class="btn btn-outline-primary btn-sm">Vis dem jeg kan deltage i</a>
    }
</p>

@if (Model.Aktiviteter.Count == 0)
{
    <p>Der er ingen aktiviteter at vise.</p>
}

@foreach (Aktivitet a in Model.Aktiviteter)
{
    int antal = Model.AntalTilmeldte(a);

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@a.Navn</h5>
            <p class="card-text">@a.Beskrivelse</p>
            <p class="mb-0"><b>Tidspunkt:</b> @a.Tidspunkt.ToString("dd-MM-yyyy HH:mm")</p>
            <p class="mb-0"><b>Sted:</b> @a.Sted</p>
            <p class="mb-0"><b>Ledere:</b> @Model.LederNavne(a)</p>
            <p class="mb-0"><b>Min. alder:</b> @a.MinAlder år</p>
            <p class="mb-0"><b>Krævede tegn:</b> @Model.TegnNavne(a)</p>
            <p><b>Tilmeldte:</b> @antal / @a.MaksDeltagere</p>

            @if (Model.ErLeder)
            {
                <a asp-page="Tilmeldte" asp-route-id="@a.Id" class="btn btn-primary btn-sm">Se tilmeldte</a>
                <a asp-page="Rediger" asp-route-id="@a.Id" class="btn btn-secondary btn-sm">Ret</a>
                <form method="post" asp-page-handler="Slet" asp-route-id="@a.Id" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm">Slet</button>
                </form>
            }
            else if (Model.ErTilmeldt(a))
            {
                <span class="text-success me-2">Du er tilmeldt</span>
                <form method="post" asp-page-handler="Frameld" asp-route-id="@a.Id" class="d-inline">
                    <button type="submit" class="btn btn-secondary btn-sm">Frameld</button>
                </form>
            }
            else if (Model.Grund(a) == "")
            {
                <form method="post" asp-page-handler="Tilmeld" asp-route-id="@a.Id">
                    <button type="submit" class="btn btn-success btn-sm">Tilmeld</button>
                </form>
            }
            else
            {
                <span class="text-danger">@Model.Grund(a)</span>
            }
        </div>
    </div>
}
