@page "{id:int?}"
@model DLS_Web.Pages.Aktiviteter.RedigerModel
@{
    ViewData["Title"] = "Aktivitet";
}

@if (Model.ErNy)
{
    <h1>Opret aktivitet</h1>
}
else
{
    <h1>Ret aktivitet</h1>
}

<div class="col-md-6">
    @if (Model.Fejl.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (string fejl in Model.Fejl)
            {
                <div>@fejl</div>
            }
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Aktivitet.Id" />

        <div class="mb-3">
            <label asp-for="Aktivitet.Navn" class="form-label">Navn</label>
            <input asp-for="Aktivitet.Navn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Aktivitet.Sted" class="form-label">Sted</label>
            <input asp-for="Aktivitet.Sted" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Aktivitet.Beskrivelse" class="form-label">Beskrivelse</label>
            <textarea asp-for="Aktivitet.Beskrivelse" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Aktivitet.Tidspunkt" class="form-label">Tidspunkt</label>
            <input asp-for="Aktivitet.Tidspunkt" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Aktivitet.MaksDeltagere" class="form-label">Maks deltagere</label>
            <input asp-for="Aktivitet.MaksDeltagere" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Aktivitet.MinAlder" class="form-label">Min. alder</label>
            <input asp-for="Aktivitet.MinAlder" class="form-control" required />
        </div>

        <div class="mb-3">
            <b>Ledere der står for aktiviteten</b>
            @foreach (Leder l in Model.AlleLedere)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="Aktivitet.LederIds" value="@l.Id" checked="@Model.Aktivitet.LederIds.Contains(l.Id)" />
                    <label class="form-check-label">@l.Navn</label>
                </div>
            }
        </div>

        <div class="mb-3">
            <b>Krævede tegn</b>
            @foreach (Tegn t in Model.AlleTegn)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="Aktivitet.KraevedeTegnIds" value="@t.Id" checked="@Model.Aktivitet.KraevedeTegnIds.Contains(t.Id)" />
                    <label class="form-check-label">@t.Navn</label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Gem</button>
        <a asp-page="Index" class="btn btn-secondary">Tilbage</a>
    </form>
</div>
