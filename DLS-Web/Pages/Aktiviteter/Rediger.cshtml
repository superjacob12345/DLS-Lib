@page "{id:int}"
@model DLS_Web.Pages.Aktiviteter.RedigerModel
@{
    ViewData["Title"] = "Rediger aktivitet";
}

<h1>Rediger aktivitet</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Aktivitet.Id" />

    <div class="mb-3">
        <label asp-for="Aktivitet.Navn" class="form-label">Navn</label>
        <input asp-for="Aktivitet.Navn" class="form-control" />
        <span asp-validation-for="Aktivitet.Navn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Aktivitet.Tidspunkt" class="form-label">Tidspunkt</label>
        <input asp-for="Aktivitet.Tidspunkt" class="form-control" />
        <span asp-validation-for="Aktivitet.Tidspunkt" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Aktivitet.MaksDeltagere" class="form-label">Maks deltagere</label>
        <input asp-for="Aktivitet.MaksDeltagere" class="form-control" min="1" />
        <span asp-validation-for="Aktivitet.MaksDeltagere" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Aktivitet.MinAlder" class="form-label">Min. alder</label>
        <input asp-for="Aktivitet.MinAlder" class="form-control" min="0" />
        <span asp-validation-for="Aktivitet.MinAlder" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-page="Index" class="btn btn-link">Tilbage</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
