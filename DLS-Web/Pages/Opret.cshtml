@page
@model DLS_Web.Pages.OpretModel
@{
    ViewData["Title"] = "Opret bruger";
}

<h1>Opret bruger</h1>
<p>Her kan du oprette dig som spejder. Ledere skal oprettes af en anden leder.</p>

<div class="col-md-4">
    @if (Model.Fejl.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (string fejl in Model.Fejl)
            {
                <div>@fejl</div>
            }
        </div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="Navn" class="form-label">Navn</label>
            <input asp-for="Navn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Foedselsdato" class="form-label">Fødselsdato</label>
            <input asp-for="Foedselsdato" type="date" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="BrugerNavn" class="form-label">Brugernavn</label>
            <input asp-for="BrugerNavn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Adgangskode" class="form-label">Adgangskode</label>
            <input asp-for="Adgangskode" type="password" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="GentagAdgangskode" class="form-label">Gentag adgangskode</label>
            <input asp-for="GentagAdgangskode" type="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Opret bruger</button>
    </form>

    <p class="mt-3">Har du allerede en bruger? <a asp-page="/Login">Log ind</a></p>
</div>
