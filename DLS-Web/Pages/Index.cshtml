@page
@model IndexModel
@{
    ViewData["Title"] = "Forside";
    string? rolle = HttpContext.Session.GetString("Rolle");
}

<section class="hero mb-4">
    <span class="hero-maerke">Landslejr · Hedeland ved Roskilde</span>
    @if (rolle == null)
    {
        <h1>En uge fuld af eventyr</h1>
        <p>Hvert 5. år samles De Lyserøde Spejdere fra hele landet. Find ugens aktiviteter og tilmeld dig dem, du har lyst til.</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Login" class="btn btn-light btn-lg">Log ind og kom i gang</a>
            <a asp-page="/Opret" class="btn btn-outline-light btn-lg">Opret bruger</a>
        </div>
    }
    else
    {
        <h1>Hej @(HttpContext.Session.GetString("Navn") ?? "").Split(' ')[0]!</h1>
        @if (rolle == "Spejder")
        {
            <p>Du er tilmeldt @Model.MineTilmeldinger @(Model.MineTilmeldinger == 1 ? "aktivitet" : "aktiviteter"). Se hvad der ellers sker på lejren.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="/Aktiviteter/Index" class="btn btn-light btn-lg">Find aktiviteter</a>
                <a asp-page="/MineAktiviteter" class="btn btn-outline-light btn-lg">Mine aktiviteter</a>
            </div>
        }
        else
        {
            <p>Opret og ret ugens aktiviteter, og se hvem der deltager.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="/Aktiviteter/Index" class="btn btn-light btn-lg">Gå til aktiviteter</a>
                <a asp-page="/Aktiviteter/Rediger" class="btn btn-outline-light btn-lg">+ Ny aktivitet</a>
            </div>
        }
    }
    <div class="hero-telte" aria-hidden="true">⛺🔥⛺</div>
</section>

@if (rolle == "Leder")
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="panel"><div class="tal">@Model.AntalAktiviteter</div><div class="tal-tekst">aktiviteter</div></div></div>
        <div class="col-md-4"><div class="panel"><div class="tal">@Model.AntalSpejdere</div><div class="tal-tekst">spejdere</div></div></div>
        <div class="col-md-4"><div class="panel"><div class="tal">@Model.AntalTilmeldinger</div><div class="tal-tekst">tilmeldinger</div></div></div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="panel h-100 fakta">
                <div class="fakta-ikon">🔥</div>
                <div><h3>Aktiviteter hele ugen</h3><p>Mad over bål, ridning, kanoture, natløb og meget mere.</p></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel h-100 fakta">
                <div class="fakta-ikon">✋</div>
                <div><h3>Tilmeld dig selv</h3><p>Se med det samme om der er plads, og om du har den rigtige alder og de rigtige tegn.</p></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel h-100 fakta">
                <div class="fakta-ikon">⚜</div>
                <div><h3>Lederne styrer</h3><p>Lederne opretter aktiviteterne og kan altid se, hvem der deltager.</p></div>
            </div>
        </div>
    </div>
}

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 m-0">Det sker snart</h2>
        @if (rolle != null)
        {
            <a asp-page="/Aktiviteter/Index">Se hele programmet →</a>
        }
    </div>

    @if (Model.Kommende.Count == 0)
    {
        <p class="text-secondary m-0">Der er ingen kommende aktiviteter.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var a in Model.Kommende)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="akt-tid text-start p-3 h-100">
                        <small>@a.Tidspunkt.ToString("ddd d. MMM 'kl.' HH:mm")</small>
                        <div class="fw-bold mt-1">@a.Navn</div>
                        <small>📍 @a.Sted</small>
                    </div>
                </div>
            }
        </div>
    }
</div>
