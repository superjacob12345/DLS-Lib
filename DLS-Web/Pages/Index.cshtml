@page
@model IndexModel
@{
    ViewData["Title"] = "Forside";
    string? rolle = HttpContext.Session.GetString("Rolle");
}

<h1>Velkommen til landslejren</h1>
<p>Hvert 5. år samles De Lyserøde Spejdere i Hedeland ved Roskilde. Her kan du se ugens aktiviteter og tilmelde dig.</p>

@if (rolle == null)
{
    <a asp-page="/Login" class="btn btn-primary">Log ind</a>
    <a asp-page="/Opret" class="btn btn-secondary">Opret bruger</a>
}
else
{
    <a asp-page="/Aktiviteter/Index" class="btn btn-primary">Gå til aktiviteter</a>
}

<h2 class="mt-4">Kommende aktiviteter</h2>

@if (Model.Kommende.Count == 0)
{
    <p>Der er ingen kommende aktiviteter.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Tidspunkt</th>
            <th>Aktivitet</th>
            <th>Sted</th>
        </tr>
        @foreach (Aktivitet a in Model.Kommende)
        {
            <tr>
                <td>@a.Tidspunkt.ToString("dd-MM-yyyy HH:mm")</td>
                <td>@a.Navn</td>
                <td>@a.Sted</td>
            </tr>
        }
    </table>
}
