@page "{id:int?}"
@model DLS_Web.Pages.Ledere.RedigerModel
@{
    ViewData["Title"] = "Leder";
}

@if (Model.ErNy)
{
    <h1>Opret leder</h1>
}
else
{
    <h1>Ret leder</h1>
}

<div class="col-md-4">
    @if (Model.Fejl.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (string fejl in Model.Fejl)
            {
                <div>@fejl</div>
            }
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Leder.Id" />

        <div class="mb-3">
            <label asp-for="Leder.Navn" class="form-label">Navn</label>
            <input asp-for="Leder.Navn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Leder.BrugerNavn" class="form-label">Brugernavn</label>
            <input asp-for="Leder.BrugerNavn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Leder.Adgangskode" class="form-label">Adgangskode</label>
            <input asp-for="Leder.Adgangskode" type="password" class="form-control" />
            @if (!Model.ErNy)
            {
                <div class="form-text">Lad feltet stå tomt for at beholde den gamle adgangskode.</div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Gem</button>
        <a asp-page="Index" class="btn btn-secondary">Tilbage</a>
    </form>
</div>
