@page
@model DLS_Web.Pages.Ledere.OpretModel
@{
    ViewData["Title"] = "Opret leder";
}

<h1>Opret leder</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Leder.Navn" class="form-label">Navn</label>
        <input asp-for="Leder.Navn" class="form-control" />
        <span asp-validation-for="Leder.Navn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Leder.BrugerNavn" class="form-label">Brugernavn</label>
        <input asp-for="Leder.BrugerNavn" class="form-control" />
        <span asp-validation-for="Leder.BrugerNavn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Leder.Adgangskode" class="form-label">Adgangskode</label>
        <input asp-for="Leder.Adgangskode" type="password" class="form-control" />
        <span asp-validation-for="Leder.Adgangskode" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Opret</button>
    <a asp-page="Index" class="btn btn-link">Tilbage</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
