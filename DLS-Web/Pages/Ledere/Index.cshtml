@page
@model DLS_Web.Pages.Ledere.IndexModel
@{
    ViewData["Title"] = "Ledere";
}

<div class="side-top">
    <div>
        <h1>Ledere</h1>
        <p>Ledere kan oprette aktiviteter og se hvem der deltager.</p>
    </div>
    <a asp-page="Rediger" class="btn btn-primary">+ Ny leder</a>
</div>

<div class="panel tabel-panel">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Brugernavn</th>
                    <th>Står for</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Ledere)
                {
                    <tr>
                        <td class="fw-bold">
                            @l.Navn
                            @if (l.Id == Model.MitId)
                            {
                                <span class="chip chip-ok ms-1">Dig</span>
                            }
                        </td>
                        <td>@l.BrugerNavn</td>
                        <td>
                            <div class="chips mb-0">
                                @foreach (var a in Model.HentAktiviteter(l))
                                {
                                    <span class="chip">@a.Navn</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="handlinger">
                                <a asp-page="Rediger" asp-route-id="@l.Id" class="btn btn-lys btn-sm">Ret</a>
                                @if (l.Id != Model.MitId)
                                {
                                    <form method="post" asp-page-handler="Slet" asp-route-id="@l.Id">
                                        <button type="submit" class="btn btn-fare btn-sm" onclick="return confirm('Vil du slette @l.Navn?')">Slet</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
