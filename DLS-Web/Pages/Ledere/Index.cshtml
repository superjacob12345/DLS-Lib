@page
@model DLS_Web.Pages.Ledere.IndexModel
@{
    ViewData["Title"] = "Ledere";
}

<h1>Ledere</h1>

<a asp-page="Rediger" class="btn btn-primary mb-3">Opret ny leder</a>

<table class="table">
    <tr>
        <th>Navn</th>
        <th>Brugernavn</th>
        <th>Står for</th>
        <th></th>
    </tr>
    @foreach (Leder l in Model.Ledere)
    {
        <tr>
            <td>@l.Navn</td>
            <td>@l.BrugerNavn</td>
            <td>@Model.AktivitetNavne(l)</td>
            <td>
                <a asp-page="Rediger" asp-route-id="@l.Id" class="btn btn-secondary btn-sm">Ret</a>
                @if (l.Id != Model.MitId)
                {
                    <form method="post" asp-page-handler="Slet" asp-route-id="@l.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Slet</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
