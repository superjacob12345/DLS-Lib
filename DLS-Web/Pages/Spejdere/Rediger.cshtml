@page "{id:int?}"
@model DLS_Web.Pages.Spejdere.RedigerModel
@{
    ViewData["Title"] = "Spejder";
}

@if (Model.ErNy)
{
    <h1>Opret spejder</h1>
}
else
{
    <h1>Ret spejder</h1>
}

<div class="col-md-4">
    @if (Model.Fejl.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (string fejl in Model.Fejl)
            {
                <div>@fejl</div>
            }
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Spejder.Id" />

        <div class="mb-3">
            <label asp-for="Spejder.Navn" class="form-label">Navn</label>
            <input asp-for="Spejder.Navn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Spejder.Foeselsdag" class="form-label">Fødselsdato</label>
            <input asp-for="Spejder.Foeselsdag" type="date" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Spejder.BrugerNavn" class="form-label">Brugernavn</label>
            <input asp-for="Spejder.BrugerNavn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Spejder.Adgangskode" class="form-label">Adgangskode</label>
            <input asp-for="Spejder.Adgangskode" type="password" class="form-control" />
            @if (!Model.ErNy)
            {
                <div class="form-text">Lad feltet stå tomt for at beholde den gamle adgangskode.</div>
            }
        </div>

        <div class="mb-3">
            <b>Tegn spejderen har taget</b>
            @foreach (Tegn t in Model.AlleTegn)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="Spejder.TegnIds" value="@t.Id" checked="@Model.Spejder.TegnIds.Contains(t.Id)" />
                    <label class="form-check-label">@t.Navn</label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Gem</button>
        <a asp-page="Index" class="btn btn-secondary">Tilbage</a>
    </form>
</div>
