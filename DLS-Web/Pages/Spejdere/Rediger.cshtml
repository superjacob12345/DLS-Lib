@page "{id:int}"
@model DLS_Web.Pages.Spejdere.RedigerModel
@{
    ViewData["Title"] = "Rediger spejder";
}

<h1>Rediger spejder</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Spejder.Id" />

    <div class="mb-3">
        <label asp-for="Spejder.Navn" class="form-label">Navn</label>
        <input asp-for="Spejder.Navn" class="form-control" />
        <span asp-validation-for="Spejder.Navn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Spejder.BrugerNavn" class="form-label">Brugernavn</label>
        <input asp-for="Spejder.BrugerNavn" class="form-control" />
        <span asp-validation-for="Spejder.BrugerNavn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Spejder.Adgangskode" class="form-label">Adgangskode</label>
        <input asp-for="Spejder.Adgangskode" type="password" value="@Model.Spejder.Adgangskode" class="form-control" />
        <span asp-validation-for="Spejder.Adgangskode" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Spejder.Foedselsdato" class="form-label">Fødselsdato</label>
        <input asp-for="Spejder.Foedselsdato" type="date" class="form-control" />
        <span asp-validation-for="Spejder.Foedselsdato" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-page="Index" class="btn btn-link">Tilbage</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
