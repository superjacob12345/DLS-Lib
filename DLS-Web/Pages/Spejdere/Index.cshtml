@page
@model DLS_Web.Pages.Spejdere.IndexModel
@{
    ViewData["Title"] = "Spejdere";
}

<h1>Spejdere</h1>

<a asp-page="Rediger" class="btn btn-primary mb-3">Opret ny spejder</a>

@if (Model.Spejdere.Count == 0)
{
    <p>Der er ingen spejdere endnu.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Navn</th>
            <th>Brugernavn</th>
            <th>Alder</th>
            <th>Tegn</th>
            <th>Tilmeldinger</th>
            <th></th>
        </tr>
        @foreach (Spejder s in Model.Spejdere)
        {
            <tr>
                <td>@s.Navn</td>
                <td>@s.BrugerNavn</td>
                <td>@s.Alder år</td>
                <td>@Model.TegnNavne(s)</td>
                <td>@Model.AntalTilmeldinger(s)</td>
                <td>
                    <a asp-page="Rediger" asp-route-id="@s.Id" class="btn btn-secondary btn-sm">Ret</a>
                    <form method="post" asp-page-handler="Slet" asp-route-id="@s.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Slet</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
