@page
@model DLS_Web.Pages.Spejdere.IndexModel
@{
    ViewData["Title"] = "Spejdere";
}

<div class="side-top">
    <div>
        <h1>Spejdere</h1>
        <p>@Model.Spejdere.Count spejdere på lejren</p>
    </div>
    <a asp-page="Rediger" class="btn btn-primary">+ Ny spejder</a>
</div>

@if (Model.Spejdere.Count == 0)
{
    <div class="panel tom">
        <span class="tom-ikon">🧒</span>
        <p class="mb-0">Der er ingen spejdere endnu.</p>
    </div>
}
else
{
    <div class="panel tabel-panel">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Navn</th>
                        <th>Brugernavn</th>
                        <th>Alder</th>
                        <th>Tegn</th>
                        <th>Tilmeldinger</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Spejdere)
                    {
                        <tr>
                            <td class="fw-bold">@s.Navn</td>
                            <td>@s.BrugerNavn</td>
                            <td>@s.Alder år</td>
                            <td>
                                <div class="chips mb-0">
                                    @foreach (var t in Model.HentTegn(s))
                                    {
                                        <span class="chip chip-tegn">@t.Navn</span>
                                    }
                                </div>
                            </td>
                            <td>@Model.AntalTilmeldinger(s)</td>
                            <td>
                                <div class="handlinger">
                                    <a asp-page="Rediger" asp-route-id="@s.Id" class="btn btn-lys btn-sm">Ret</a>
                                    <form method="post" asp-page-handler="Slet" asp-route-id="@s.Id">
                                        <button type="submit" class="btn btn-fare btn-sm">Slet</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
