@page
@model DLS_Web.Pages.MineAktiviteterModel
@{
    ViewData["Title"] = "Mine aktiviteter";
}

<h1>Mine aktiviteter</h1>
<p>@Model.MigSelv.Navn, @Model.MigSelv.Alder år</p>

<h4>Mine tegn</h4>
@if (Model.MineTegn.Count == 0)
{
    <p>Du har ikke nogen tegn endnu.</p>
}
else
{
    <ul>
        @foreach (Tegn t in Model.MineTegn)
        {
            <li>@t.Navn</li>
        }
    </ul>
}

<h4>Aktiviteter jeg er tilmeldt</h4>
@if (Model.Aktiviteter.Count == 0)
{
    <p>Du er ikke tilmeldt nogen aktiviteter endnu.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Tidspunkt</th>
            <th>Aktivitet</th>
            <th>Sted</th>
            <th></th>
        </tr>
        @foreach (Aktivitet a in Model.Aktiviteter)
        {
            <tr>
                <td>@a.Tidspunkt.ToString("dd-MM-yyyy HH:mm")</td>
                <td>@a.Navn</td>
                <td>@a.Sted</td>
                <td>
                    <form method="post" asp-page-handler="Frameld" asp-route-id="@a.Id">
                        <button type="submit" class="btn btn-secondary btn-sm">Frameld</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}

<a asp-page="/Aktiviteter/Index" class="btn btn-primary">Find flere aktiviteter</a>
