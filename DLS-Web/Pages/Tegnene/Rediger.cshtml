@page "{id:int?}"
@model DLS_Web.Pages.Tegnene.RedigerModel
@{
    ViewData["Title"] = "Tegn";
}

@if (Model.ErNy)
{
    <h1>Opret tegn</h1>
}
else
{
    <h1>Ret tegn</h1>
}

<div class="col-md-4">
    @if (Model.Fejl.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (string fejl in Model.Fejl)
            {
                <div>@fejl</div>
            }
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Tegn.Id" />

        <div class="mb-3">
            <label asp-for="Tegn.Navn" class="form-label">Navn</label>
            <input asp-for="Tegn.Navn" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Gem</button>
        <a asp-page="Index" class="btn btn-secondary">Tilbage</a>
    </form>
</div>
