@page
@model DLS_Web.Pages.Tegnene.IndexModel
@{
    ViewData["Title"] = "Tegn";
}

<h1>Tegn</h1>
<p>Tegn er færdigheder spejderne kan have. Nogle aktiviteter kræver bestemte tegn.</p>

<a asp-page="Rediger" class="btn btn-primary mb-3">Opret nyt tegn</a>

@if (Model.Tegn.Count == 0)
{
    <p>Der er ingen tegn endnu.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Navn</th>
            <th>Antal spejdere med tegnet</th>
            <th>Antal aktiviteter der kræver det</th>
            <th></th>
        </tr>
        @foreach (Tegn t in Model.Tegn)
        {
            <tr>
                <td>@t.Navn</td>
                <td>@Model.AntalSpejdere(t)</td>
                <td>@Model.AntalAktiviteter(t)</td>
                <td>
                    <a asp-page="Rediger" asp-route-id="@t.Id" class="btn btn-secondary btn-sm">Ret</a>
                    <form method="post" asp-page-handler="Slet" asp-route-id="@t.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Slet</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
