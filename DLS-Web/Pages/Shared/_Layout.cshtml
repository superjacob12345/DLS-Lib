@{
    string? rolle = Context.Session.GetString("Rolle");
    string? navn = Context.Session.GetString("Navn");
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - De Lyserøde Spejdere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">De Lyserøde Spejdere</a>
                <ul class="navbar-nav me-auto">
                    @if (rolle != null)
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Aktiviteter/Index">Aktiviteter</a></li>
                    }
                    @if (rolle == "Spejder")
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/MineAktiviteter">Mine aktiviteter</a></li>
                    }
                    @if (rolle == "Leder")
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Spejdere/Index">Spejdere</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Ledere/Index">Ledere</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Tegnene/Index">Tegn</a></li>
                    }
                </ul>
                @if (rolle == null)
                {
                    <a class="nav-link me-3" asp-page="/Opret">Opret bruger</a>
                    <a class="btn btn-light btn-sm" asp-page="/Login">Log ind</a>
                }
                else
                {
                    <span class="me-3">@navn (@rolle)</span>
                    <form method="post" asp-page="/Logout">
                        <button type="submit" class="btn btn-light btn-sm">Log ud</button>
                    </form>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main class="pb-3">
            @if (TempData["Besked"] != null)
            {
                <div class="alert alert-success">@TempData["Besked"]</div>
            }
            @if (TempData["Fejl"] != null)
            {
                <div class="alert alert-danger">@TempData["Fejl"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - De Lyserøde Spejdere
        </div>
    </footer>
</body>
</html>
