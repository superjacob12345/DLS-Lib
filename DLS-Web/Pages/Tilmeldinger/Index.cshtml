@page
@model DLS_Web.Pages.Tilmeldinger.IndexModel
@{
    ViewData["Title"] = "Tilmeldinger";
}

<h1>Tilmeldinger</h1>

<form method="post" asp-page-handler="Tilmeld" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label asp-for="SpejderId" class="form-label">Spejder</label>
        <select asp-for="SpejderId" class="form-select">
            <option value="0">-- Vælg spejder --</option>
            @foreach (var s in Model.Spejdere)
            {
                <option value="@s.Id">@s.Navn (@s.Alder år)</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="AktivitetId" class="form-label">Aktivitet</label>
        <select asp-for="AktivitetId" class="form-select">
            <option value="0">-- Vælg aktivitet --</option>
            @foreach (var a in Model.Aktiviteter)
            {
                <option value="@a.Id">@a.Navn (min. @a.MinAlder år)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Tilmeld</button>
    </div>
</form>

@if (Model.Fejl != "")
{
    <div class="alert alert-danger">@Model.Fejl</div>
}

@if (Model.Tilmeldinger.Count == 0)
{
    <p>Der er ingen tilmeldinger endnu.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Spejder</th>
                <th>Aktivitet</th>
                <th>Tilmeldt den</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Tilmeldinger)
            {
                <tr>
                    <td>@Model.SpejderNavn(t.SpejderId)</td>
                    <td>@Model.AktivitetNavn(t.AktivitetId)</td>
                    <td>@t.Dato.ToString("dd-MM-yyyy")</td>
                    <td>
                        <form method="post" asp-page-handler="Frameld" asp-route-spejderId="@t.SpejderId" asp-route-aktivitetId="@t.AktivitetId">
                            <button type="submit" class="btn btn-sm btn-danger">Frameld</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
